  <order>
    <hop>
      <from>Read Gebäude </from>
      <to>Join rows (cartesian product)</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Raster Clip</from>
      <to>Join rows (cartesian product)</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>Raster Clip</name>
    <type>GDAL_RASTER_CLIP_TRANSFORM</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <addAlpha>N</addAlpha>
    <addResultFields>Y</addResultFields>
    <authType>NONE</authType>
    <bounds>2607637,1228726,2607884,1228906</bounds>
    <clipMode>BOUNDING_BOX</clipMode>
    <clipParameterSourceMode>CONSTANT</clipParameterSourceMode>
    <compressionPreset>DEFLATE</compressionPreset>
    <failOnError>Y</failOnError>
    <inputSourceMode>HTTP_URL</inputSourceMode>
    <inputValue>https://files.geo.so.ch/ch.swisstopo.lidar_2023.ndsm_buildings/aktuell/ch.swisstopo.lidar_2023.ndsm_buildings.tif</inputValue>
    <inputValueMode>CONSTANT</inputValueMode>
    <outputFormat>GTiff</outputFormat>
    <outputSourceMode>LOCAL_FILE</outputSourceMode>
    <outputValue>/Users/stefan/tmp/hoptemp/buildings_clipped.tif</outputValue>
    <outputValueMode>CONSTANT</outputValueMode>
    <outputWriteMode>OVERWRITE</outputWriteMode>
    <templateSourceMode>LOCAL_FILE</templateSourceMode>
    <attributes/>
    <GUI>
      <xloc>128</xloc>
      <yloc>128</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Read Gebäude </name>
    <type>OGR_INPUT_TRANSFORM</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributeFilter>art_txt = 'Gebaeude'</attributeFilter>
    <bbox>2607637,1228726,2607884,1228906</bbox>
    <fidFieldName>fid</fidFieldName>
    <fileName>/Users/stefan/Downloads/2601.ch.so.agi.av.mopublic.gpkg</fileName>
    <geometryFieldName>geometry</geometryFieldName>
    <includeFid>Y</includeFid>
    <layerName>bodenbedeckung</layerName>
    <attributes/>
    <GUI>
      <xloc>464</xloc>
      <yloc>144</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Join rows (cartesian product)</name>
    <type>JoinRows</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <cache_size>500</cache_size>
    <compare>
      <condition>
        <conditions>
</conditions>
        <function>=</function>
        <negated>N</negated>
        <operator>-</operator>
      </condition>
    </compare>
    <directory>%%java.io.tmpdir%%</directory>
    <main/>
    <prefix>out</prefix>
    <attributes/>
    <GUI>
      <xloc>304</xloc>
      <yloc>272</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes/>
</pipeline>
